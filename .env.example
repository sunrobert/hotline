# Copy to .env.local, or run `npm run setup` to generate one with fresh testnet keys.
# Arc TESTNET only. Never put a key that holds real funds in here.

# --- Limits (USDC) ---
PER_TX_CAP=250
DAILY_CAP=1000
APPROVAL_THRESHOLD=50
GAS_RESERVE_USDC=1

# --- Sweep rule: keep this much on hand, move the rest to SAVINGS_LABEL ---
SWEEP_THRESHOLD_USDC=100
SAVINGS_LABEL=savings

# --- Recipients. Labels only; the agent never accepts a raw address. ---
ALLOWLIST=savings:0x0000000000000000000000000000000000000000,alice:0x0000000000000000000000000000000000000000
ALLOWLIST_ALIASES="savings:储蓄|存款,alice:爱丽丝"

# --- Owner ---
# E.164, comma-separated. The only numbers allowed to command the agent.
OWNER_NUMBERS=+15555550100
# At least four digits. Spoken to approve anything over APPROVAL_THRESHOLD. Rotate after a live demo.
OWNER_PIN=
OWNER_LANGUAGE=en

# --- Secrets ---
# Sent by the voice agent's tool calls as X-Hotline-Secret.
HOTLINE_SECRET=
# Required for dashboard writes (unpause, simulate).
DASHBOARD_TOKEN=

# --- Chain ---
ARC_RPC_URL=https://rpc.testnet.arc.io
AGENT_PRIVATE_KEY=

# --- Demo wallets (used by scripts only; the server never reads these) ---
SENDER_PRIVATE_KEY=
SAVINGS_PRIVATE_KEY=
ALICE_PRIVATE_KEY=

# --- Voice agent (ElevenLabs) ---
ELEVENLABS_API_KEY=
# Where ElevenLabs can reach this backend. Set once deployed, then run `npm run agent`.
PUBLIC_URL=
# AGENT_LLM=claude-sonnet-5-5

# --- Optional ---
# PORT=8787
# DB_PATH=data/hotline.db
# PENDING_TTL_SEC=600
# DAILY_RESET_UTC=0
